<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Opp_Advanced_to_Proposal_or_Beyond</name>
        <label>Opp Advanced to Proposal or Beyond</label>
        <locationX>767</locationX>
        <locationY>355</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>SLA_Time_Stamps</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SLA_Proposal_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ProposalDatevsCreatedDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>30.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Gamification_Record</targetReference>
            </connector>
            <label>SLA Time Stamps</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>ProposalDatevsCreatedDate</name>
        <dataType>Number</dataType>
        <expression>{!$Record.SLA_Proposal_Date_Time__c}-{!$Record.CreatedDate}</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Gamification - Opportunity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Gamification - Opportunity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
