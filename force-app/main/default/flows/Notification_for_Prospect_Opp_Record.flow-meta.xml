    <formulas>
        <name>DynamicSubjectLine</name>
        <dataType>String</dataType>
        <expression>IF(
  {!$Record.CS_Stage_Duration__c} = 181,
  &quot;Aging Prospect Stage Opportunity &quot; &amp; {!$Record.Name},
  IF(
    {!$Record.CS_Stage_Duration__c} = 188,
    &quot;Aging Prospect Stage Opportunity &quot; &amp; {!$Record.Name} &amp; &quot; | 2nd Follow Up&quot;,
    &quot;Aging Prospect Stage Opportunity &quot; &amp; {!$Record.Name} &amp; &quot; | 3rd &amp; Final Follow Up&quot;
  )
)</expression>
    </formulas>
