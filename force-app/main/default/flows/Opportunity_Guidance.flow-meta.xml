            </visibilityRule>
        </fields>
        <fields>
            <name>recentUpdate</name>
            <fieldText>&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;--------------------------------------------------------------------&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: verdana; font-size: 14px;&quot;&gt;Here is the recent update from &lt;/span&gt;&lt;strong style=&quot;font-family: verdana; font-size: 14px;&quot;&gt;{!formUpdateDate}&lt;/strong&gt;&lt;span style=&quot;font-family: verdana; font-size: 14px;&quot;&gt;:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;u style=&quot;font-family: verdana; font-size: 14px;&quot;&gt;Activity Summary&lt;/u&gt;&lt;/p&gt;&lt;p&gt;&lt;em style=&quot;font-family: verdana; font-size: 14px;&quot;&gt;{!getOpportunity.Recent_Summary_of_Activity__c}&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;u style=&quot;font-family: verdana; font-size: 14px;&quot;&gt;Help Requested&lt;/u&gt;&lt;/p&gt;&lt;p&gt;&lt;em style=&quot;font-family: verdana; font-size: 14px;&quot;&gt;{!getOpportunity.Recent_Help_Requested__c}&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;u style=&quot;font-family: verdana; font-size: 14px;&quot;&gt;Next Steps&lt;/u&gt;&lt;/p&gt;&lt;p&gt;&lt;em style=&quot;font-family: verdana; font-size: 14px;&quot;&gt;{!getOpportunity.Recent_Summary_of_Next_Steps__c}&lt;/em&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
