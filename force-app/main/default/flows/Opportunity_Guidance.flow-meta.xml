        <fields>
            <name>Qualified_Guidance</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;&lt;u&gt;Qualified&lt;/u&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;The Qualified stage is where all the directional model and service line information should be provided and the opportunity record becomes eligible for pipeline reports and dashboards. Additionally:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;color: rgb(68, 68, 68); font-family: &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: 10pt;&quot;&gt;&amp;nbsp;&lt;/strong&gt;&lt;/p&gt;&lt;p class=&quot;ql-indent-1&quot;&gt;&lt;strong style=&quot;font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;Client context has been researched&lt;/strong&gt;&lt;/p&gt;&lt;p class=&quot;ql-indent-1&quot;&gt;&lt;strong style=&quot;font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;Stakeholders have been identified&lt;/strong&gt;&lt;/p&gt;&lt;p class=&quot;ql-indent-1&quot;&gt;&lt;strong style=&quot;font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;Initial meetings have been held&lt;/strong&gt;&lt;/p&gt;&lt;p class=&quot;ql-indent-1&quot;&gt;&lt;strong style=&quot;font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;Estimated scope of opportunity is understood&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
