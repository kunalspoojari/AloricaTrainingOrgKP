                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Qualified</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Pricing_Guidance</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;&lt;u&gt;Pricing&lt;/u&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;The Pricing stage is where valuable collaboration happens between internal teams to build the most valuable solution for the client. Additionally:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;ql-indent-1&quot;&gt;&lt;strong style=&quot;color: rgb(68, 68, 68); font-family: &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: 10pt;&quot;&gt;Needs analysis completed&lt;/strong&gt;&lt;/p&gt;&lt;p class=&quot;ql-indent-1&quot;&gt;&lt;strong style=&quot;color: rgb(68, 68, 68); font-family: &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: 10pt;&quot;&gt;Alorica credibility and differentiators acknowledged&lt;/strong&gt;&lt;/p&gt;&lt;p class=&quot;ql-indent-1&quot;&gt;&lt;strong style=&quot;color: rgb(68, 68, 68); font-family: &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: 10pt;&quot;&gt;Competitive landscape understood&lt;/strong&gt;&lt;/p&gt;&lt;p class=&quot;ql-indent-1&quot;&gt;&lt;strong style=&quot;color: rgb(68, 68, 68); font-family: &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: 10pt;&quot;&gt;Customer buying cycle understood&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); font-family: &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: 10pt;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); font-size: 9pt;&quot;&gt;﻿&lt;/span&gt;&lt;span style=&quot;color: rgb(68, 68, 68); font-size: 9pt; font-family: Verdana, sans-serif;&quot;&gt;When the &lt;/span&gt;&lt;strong style=&quot;color: rgb(68, 68, 68); font-size: 9pt; font-family: Verdana, sans-serif;&quot;&gt;Verbal Win Date&lt;/strong&gt;&lt;span style=&quot;color: rgb(68, 68, 68); font-size: 9pt; font-family: Verdana, sans-serif;&quot;&gt; field is populated, two things happen:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;No more changes can be made to models and/or services by the opportunity owner without assistance from Sales Operations.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;The stage is automatically advanced.&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
