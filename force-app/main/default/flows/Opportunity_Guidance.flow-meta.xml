        </fields>
        <fields>
            <name>Verbal_Win_Guidance</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;&lt;u&gt;Verbal Win&lt;/u&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;Congratulations, this deal has reached Verbal Win!&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;As a reminder, the opportunity will advance to Contract Negotiation after &lt;/span&gt;&lt;em style=&quot;font-size: 9pt;&quot;&gt;{!getOpportunity.IT_Assignee__r.FirstName}&lt;/em&gt;&lt;span style=&quot;font-size: 9pt; color: rgb(68, 68, 68); font-family: Verdana, sans-serif;&quot;&gt;, &lt;/span&gt;&lt;em style=&quot;font-size: 9pt;&quot;&gt;{!getOpportunity.Pricing_Assignee__r.FirstName}&lt;/em&gt;&lt;span style=&quot;font-size: 9pt; color: rgb(68, 68, 68); font-family: Verdana, sans-serif;&quot;&gt;, and &lt;/span&gt;&lt;em style=&quot;font-size: 9pt;&quot;&gt;{!getOpportunity.WFM_Assignee__r.FirstName}&lt;/em&gt;&lt;span style=&quot;font-size: 9pt; color: rgb(68, 68, 68); font-family: Verdana, sans-serif;&quot;&gt; have provided their unanimous approval.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;No changes can be made to models and/or services by the opportunity owner without assistance from Sales Operations.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>getOpportunity.StageName</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Verbal Win</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Contract_Negotiation_Guidance</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;&lt;u&gt;Contract Negotiation&lt;/u&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;Welcome to the Contract Negotiation stage!&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); font-family: &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: 10pt;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;This is the last stop before closing out this opportunity. When you are ready to indicate the deal has closed, please click the &lt;/span&gt;&lt;strong style=&quot;color: rgb(68, 68, 68); font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;Close Opp &lt;/strong&gt;&lt;span style=&quot;color: rgb(68, 68, 68); font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;button above and complete the Seller Survey. An email will be sent to Sales Operations to review the corresponding deal paperwork and close the deal as won on your behalf.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;No changes can be made to models and/or services by the opportunity owner without assistance from Sales Operations.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>getOpportunity.StageName</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Contract Negotiation</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Closed_Won_Guidance</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;&lt;u&gt;Closed Won&lt;/u&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(68, 68, 68); font-family: Verdana, sans-serif; font-size: 9pt;&quot;&gt;No changes can be made to models and/or services by the opportunity owner without assistance from Sales Operations.&lt;/span&gt;&lt;/p&gt;</fieldText>
