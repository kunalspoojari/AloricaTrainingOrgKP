    <description>Previous revenue start date logic added</description>
    <environments>Default</environments>
    <formulas>
        <name>ARR</name>
        <dataType>Currency</dataType>
        <expression>IF(
{!$Record.Contract_Length_months__c}&lt;13,
{!$Record.In_Year_Forecast_Revenue__c},
({!$Record.Sum_of_Forecasted_Revenue__c}/{!$Record.Contract_Length_months__c})*12
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formClone</name>
        <dataType>Boolean</dataType>
        <expression>ISCLONE()</expression>
    </formulas>
    <formulas>
        <name>formHandleMinuteBase</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Handle_Minute_Bid_Rate__c}*({!$Record.Handle_Minutes__c}*({!$Record.Contract_Length_months__c}/12))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formMRRbase</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Monthly_Recurring_Revenue_MRR__c}*{!$Record.Contract_Length_months__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formPayrollHourBase</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Payroll_Hour_Bid_Rate__c}*({!$Record.Billable_Payroll_Hours__c}*({!$Record.Contract_Length_months__c}/12))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formProductionHourBase</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Production_Hour_Bid_Rate__c}*({!$Record.Production_Hours__c}*({!$Record.Contract_Length_months__c}/12))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formReverseCalcHandleMinute</name>
        <dataType>Currency</dataType>
        <expression>({!$Record.Monthly_Recurring_Revenue_MRR__c}*12)/{!$Record.Handle_Minutes__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formReverseCalcPayrollHour</name>
        <dataType>Currency</dataType>
        <expression>({!$Record.Monthly_Recurring_Revenue_MRR__c}*12)/{!$Record.Billable_Payroll_Hours__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formReverseCalcProductionHour</name>
        <dataType>Currency</dataType>
        <expression>({!$Record.Monthly_Recurring_Revenue_MRR__c}*12)/{!$Record.Production_Hours__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formReverseCalcTransaction</name>
        <dataType>Currency</dataType>
        <expression>({!$Record.Monthly_Recurring_Revenue_MRR__c}*12)/{!$Record.Transactions__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formTotalRevenue</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Production_Revenue__c}+{!$Record.Training_Revenue__c}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formTransactionBase</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Transaction_Bid_Rate__c}*({!$Record.Transactions__c}*({!$Record.Contract_Length_months__c}/12))</expression>
        <scale>0</scale>
    </formulas>
